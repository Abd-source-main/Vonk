      "mainEntity": [
        {
          "@type": "Question",
          "name": "Hoe lang duurt het voordat de zonnepanelen op mijn dak liggen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Na akkoord op de offerte liggen de panelen doorgaans binnen vier weken op je dak. De montage zelf is meestal in één dag klaar."
          }
        },
        {
          "@type": "Question",
          "name": "Werken jullie ook in de omgeving van Nijmegen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja. We werken in Nijmegen en de omliggende gemeenten, waaronder Beuningen, Wijchen, Malden, Groesbeek en Elst."
          }
        },
        {
          "@type": "Question",
          "name": "Kan ik zonnepanelen combineren met een thuisbatterij?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dat kan. Een thuisbatterij slaat de stroom op die je overdag opwekt, zodat je die 's avonds gebruikt. We stemmen de capaciteit af op je werkelijke verbruik en op een bestaande installatie."
          }
        }
      ]
    }
